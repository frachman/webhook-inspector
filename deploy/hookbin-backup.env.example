# Copy to /etc/hookbin/backup.env on the VPS and chmod 0600.
# Never commit the real file. Values below are placeholders.
HOOKBIN_COMPOSE_FILE=/srv/hookbin/docker-compose.yml
HOOKBIN_ENV_FILE=/srv/hookbin/.env
HOOKBIN_BACKUP_DIR=/var/lib/hookbin-backup
HOOKBIN_GPG_HOME=/etc/hookbin/backup/gnupg
HOOKBIN_GPG_RECIPIENT=REPLACE_WITH_HOMELAB_RECOVERY_FINGERPRINT
HOOKBIN_SFTP_KEY=/etc/hookbin/backup/id_ed25519
HOOKBIN_SFTP_KNOWN_HOSTS=/etc/hookbin/backup/known_hosts
HOOKBIN_SFTP_USER=backup_mikrolyt
HOOKBIN_SFTP_HOST=REPLACE_WITH_HOMELAB_TAILSCALE_IP
# The restricted SFTP account starts inside the incoming directory.
HOOKBIN_SFTP_REMOTE_DIR=.
HOOKBIN_RETENTION_DAYS=14
