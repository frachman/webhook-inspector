# Copy to /srv/hookbin/.env on the server. Never commit the real file.
# Use a long, randomly generated password for POSTGRES_PASSWORD.
POSTGRES_DB=hookbin
POSTGRES_USER=hookbin
POSTGRES_PASSWORD=replace-with-a-secret
HOOKBIN_PUBLIC_BASE_URL=https://hookbin.farandy.id

# Exact immutable image references published by the release workflow.
HOOKBIN_API_IMAGE=ghcr.io/frachman/webhook-inspector-api:sha-REPLACE_ME
HOOKBIN_WEB_IMAGE=ghcr.io/frachman/webhook-inspector-web:sha-REPLACE_ME

# Existing external Docker network owned by Caddy.
CADDY_NETWORK=web
